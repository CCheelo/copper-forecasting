\appendix
\section{Full R Output}
This appendix reproduces the key console output verbatim for reference and replication.

\subsection{Stationarity tests}
<<app-adf, echo=TRUE>>=
adf.test(price)      # level: H0 = unit root (non-stationary)
adf.test(ret)        # returns
kpss.test(ret)       # returns: H0 = stationary
@

\subsection{Fitted ARMA(2,0)}
<<app-arma, echo=TRUE>>=
fit
@

\subsection{ARMA(2,0)-GARCH(1,1)-t: variance equation and diagnostics}
<<app-garch, echo=TRUE>>=
infocriteria(fg)                                   # per-observation IC (rugarch)
cat(sprintf("Volatility persistence a1+b1 = %.4f\n", pers))
cat(sprintf("Student-t d.f. (shape)       = %.2f\n", tdf))
Box.test(z, 20, type="Ljung-Box")                  # std resid: autocorrelation
Box.test(z^2, 20, type="Ljung-Box")                # std resid^2: remaining ARCH
ArchTest(z, 12)                                    # std resid: ARCH-LM
@


<<setup, include=FALSE>>=
library(knitr)
opts_chunk$set(echo=FALSE, message=FALSE, warning=FALSE, fig.align='center',
               fig.width=7, fig.height=3.3, out.width='0.96\\linewidth',
               fig.pos='H', size='small', dev='pdf', highlight=FALSE)
options(width=92, digits=5, scipen=6)
suppressPackageStartupMessages({
  library(readxl); library(tseries); library(forecast)
  library(lmtest);  library(FinTS);  library(rugarch)
})

## ---- locate the data file (works from Copper/, the repo root, or repo/data) ----
find_data <- function(){
  cands <- c("Daily copper with dates.xlsx",
             file.path("data","Daily copper with dates.xlsx"),
             file.path("..","data","Daily copper with dates.xlsx"),
             "c:/Users/hp/Downloads/website/portfolio-website/Copper/Daily copper with dates.xlsx")
  hit <- cands[file.exists(cands)]
  if(!length(hit)) stop("Cannot find 'Daily copper with dates.xlsx'"); hit[1]
}

## ---- load & clean ----
raw <- read_excel(find_data(), sheet="Sheet1", skip=2)
names(raw) <- c("Date","Price")
raw$Date <- as.Date(raw$Date); raw$Price <- as.numeric(raw$Price)
raw <- raw[!is.na(raw$Date) & !is.na(raw$Price), ]
n_raw <- nrow(raw)
lt <- as.POSIXlt(raw$Date); bad <- (lt$year+1900) < 2000
n_typo <- sum(bad); lt$year[bad] <- lt$year[bad] + 100; raw$Date <- as.Date(lt)
raw <- raw[order(raw$Date), ]
n_dup <- sum(duplicated(raw$Date))
cu <- raw[!duplicated(raw$Date), ]
price <- cu$Price
ret   <- diff(log(price))*100
N <- length(ret)

## ---- stationarity ----
adf_lvl <- suppressWarnings(adf.test(price)); kpss_lvl <- suppressWarnings(kpss.test(price))
adf_ret <- suppressWarnings(adf.test(ret));   kpss_ret <- suppressWarnings(kpss.test(ret))

## ---- BIC grid ----
grid <- expand.grid(p=0:5, q=0:5); gres <- data.frame()
for(i in seq_len(nrow(grid))){
  p<-grid$p[i]; q<-grid$q[i]
  f<-tryCatch(arima(ret,order=c(p,0,q),include.mean=TRUE,method="ML"),
              error=function(e)NULL, warning=function(w)NULL)
  if(!is.null(f)) gres<-rbind(gres,data.frame(p=p,q=q,AIC=AIC(f),BIC=BIC(f)))
}
gres <- gres[order(gres$BIC),]

## ---- ARMA(2,0) ----
fit <- Arima(ret, order=c(2,0,0), include.mean=TRUE)
res <- residuals(fit)
lb_r   <- Box.test(res,20,"Ljung-Box",fitdf=2)
lb_r2  <- Box.test(res^2,20,"Ljung-Box")
arch_r <- ArchTest(res,12)
jb_r   <- jarque.bera.test(res)

## ---- out-of-sample backtest: last 252 trading days, fixed-coef 1-step ----
H<-252; tr<-1:(N-H); te<-(N-H+1):N
fit_tr  <- Arima(ret[tr], order=c(2,0,0), include.mean=TRUE)
fit_all <- Arima(ret, model=fit_tr)
pred_ret<- fitted(fit_all)[te]
p_prev  <- price[te]; p_act <- price[te+1]
p_arma  <- p_prev*exp(pred_ret/100); p_rw <- p_prev
rmse<-function(a,f)sqrt(mean((a-f)^2)); mae<-function(a,f)mean(abs(a-f))
bt <- data.frame(Model=c("ARMA(2,0)","Random walk"),
                 RMSE=c(rmse(p_act,p_arma),rmse(p_act,p_rw)),
                 MAE =c(mae(p_act,p_arma), mae(p_act,p_rw)))
dir_acc <- 100*mean(sign(p_act-p_prev)==sign(p_arma-p_prev))

## ---- ARMA(2,0)-GARCH(1,1)-t ----
spec <- ugarchspec(variance.model=list(model="sGARCH",garchOrder=c(1,1)),
                   mean.model=list(armaOrder=c(2,0),include.mean=TRUE),
                   distribution.model="std")
fg <- ugarchfit(spec, data=ret, solver="hybrid")
LLg <- as.numeric(likelihood(fg)); npg <- length(coef(fg))
AICg <- -2*LLg+2*npg; BICg <- -2*LLg+log(N)*npg
z  <- as.numeric(residuals(fg,standardize=TRUE))
lbz<-Box.test(z,20,"Ljung-Box"); lbz2<-Box.test(z^2,20,"Ljung-Box"); archz<-ArchTest(z,12)
pers <- as.numeric(sum(coef(fg)[c("alpha1","beta1")])); tdf <- as.numeric(coef(fg)["shape"])
cv <- as.numeric(sigma(fg))   # conditional volatility (%/day)

## comparison table
cmp <- data.frame(
  Model=c("ARMA(2,0)","ARMA(2,0)-GARCH(1,1)-t"),
  Params=c(4,npg),
  logLik=c(as.numeric(logLik(fit)),LLg),
  AIC=c(AIC(fit),AICg), BIC=c(BIC(fit),BICg),
  LB_z2_p=c(lb_r2$p.value,lbz2$p.value),
  ARCH_p =c(arch_r$p.value,archz$p.value))
@

